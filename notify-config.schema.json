{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yibai99927/claude-code-toast/notify-config.schema.json",
  "title": "Claude Code Toast Notification Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enableToast": { "type": "boolean", "default": true },
    "enableSound": { "type": "boolean", "default": true },
    "quietHours": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "minSeverity": { "type": "string", "enum": ["low", "medium", "high"] },
    "dedupeSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "showCwd": { "type": "boolean" },
    "showSummary": { "type": "boolean" },
    "summaryMaxChars": { "type": "integer", "minimum": 20, "maximum": 2000 },
    "debugLog": { "type": "boolean" },
    "language": { "type": "string", "enum": ["en", "zh-CN"] },
    "toastClickAction": { "type": "string", "enum": ["openFolder", "none"] },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "respectQuietHours": { "type": "boolean" }
        }
      }
    },
    "webhooks": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "url", "events"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["wecom", "telegram", "discord", "slack", "feishu", "dingtalk", "qmsg", "bark", "pushplus", "http"]
              },
              "url": { "type": "string", "format": "uri" },
              "events": { "type": "array", "items": { "type": "string" } },
              "chat_id": { "type": "string" },
              "token": { "type": "string" },
              "group": { "type": "string" },
              "at_mobiles": { "type": "array", "items": { "type": "string" } },
              "at_all": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
